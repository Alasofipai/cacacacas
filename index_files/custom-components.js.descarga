window.topbar = {
    toggle: function () {
        $("body").toggleClass("sidebar-toggled");
        $(".sidebar").toggleClass("toggled");
        if ($(".sidebar").hasClass("toggled")) {
            $('#accordionSidebar').hide();
            $('.sidebar .collapse').collapse('hide');
        } else {
            $('#accordionSidebar').show();
        };
    }
}

window.navMenu = {
    clickItem: function () {
        if ($(window).width() < 768) {
            $("body").addClass("sidebar-toggled");
            $(".sidebar").addClass("toggled");
            if ($(".sidebar").hasClass("toggled")) {
                $('.sidebar .collapse').collapse('hide');
            };
        }
    }
}

window.scrollableDialog = {

    init: function (dotnetReference) {
        const scrollableContainer = document.getElementById('printcontentid');        

        scrollableContainer.addEventListener('scroll', function () {
            var scrollTop = scrollableContainer.scrollTop;
            var scrollHeight = scrollableContainer.scrollHeight;
            var clientHeight = scrollableContainer.clientHeight;            
            dotnetReference.invokeMethodAsync('HandleScroll', scrollTop, scrollHeight, clientHeight);
        });
    },

    destroy: function () {        
        const scrollableContainer = document.getElementById('printcontentid');
        scrollableContainer.removeEventListener('scroll', function () { });
    }
}