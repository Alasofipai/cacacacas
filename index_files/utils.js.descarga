window.security = {

    generateSha512String: function (value) {
        if (value) {
            return sha512(value).toUpperCase();
        }

        return null;
    },

    encryptText: function (value) {

        try {
            if (!value)
                return null;

            var pubKey = document.getElementById("pubkey").value;
            var encrypt = new JSEncrypt();
            encrypt.setPublicKey(pubKey);
            return encrypt.encrypt(value);

        } catch (e) {
            return null;
        }
    },

    formatCurrency: function (value) {
        // Format the price above to USD using the locale, style, and currency.
        let currencyFormat = new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'CRC',
        });

        return currencyFormat.format(value);
    }
}


window.errorHandling = {

    showErrorBar: function (opId) {
        var errorUi = document.getElementById('blazor-error-ui');

        if (errorUi) {
            var opIdElement = document.getElementById('blazor-error-ui-op-id');
            opIdElement.textContent = opId;
            errorUi.style.display = 'block';
        }        
    },

    dismissErrorBar: function () {
        var errorUi = document.getElementById('blazor-error-ui');
        if (errorUi) {
            var opIdElement = document.getElementById('blazor-error-ui-op-id');
            opIdElement.textContent = '';
            errorUi.style.display = 'none';
        }
    }
}


window.tokenTextArea = {
    getCaretPosition: function (element) {
        return element.selectionStart;
    },

    setTextAreaValue: function (element, value) {
        element.value = value;
    }
}

window.utils = {
    loadScript: function (url) {
        const script = document.createElement("script");
        script.src = url;        
        document.head.appendChild(script);
        script.onload = () => console.log("Script cargado");
        script.onerror = () => console.error("Error cargando el script");
    }
}